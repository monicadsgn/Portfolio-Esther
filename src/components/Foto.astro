---
import { Picture } from 'astro:assets';
import { imagem } from '../lib/assets';

interface Props {
  nome: string;
  alt: string;
  widths: number[];
  sizes: string;
  class?: string;
  eager?: boolean;
}

const { nome, alt, widths, sizes, class: classe, eager = false } = Astro.props;
const src = imagem(nome);
---

{
  src ? (
    <Picture
      src={src}
      alt={alt}
      widths={widths}
      sizes={sizes}
      formats={['webp']}
      quality={72}
      class={classe}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      decoding="async"
    />
  ) : (
    <div class:list={['vazio', classe]} role="img" aria-label={`Imagem pendente: ${alt}`}>
      <span>Espaço reservado</span>
      <code>/assets/{nome}</code>
    </div>
  )
}
