---
import '@fontsource/marcellus/400.css';
import '@fontsource-variable/hanken-grotesk/wght.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';

import Foto from '../components/Foto.astro';
import Raciocinio from '../components/Raciocinio.astro';
import Carrossel from '../components/Carrossel.astro';
import CeuDoMes from '../components/CeuDoMes.astro';
import Ilustracao from '../components/Ilustracao.astro';
import CasoTopo from '../components/CasoTopo.astro';
import Etiquetas from '../components/Etiquetas.astro';
import Faixa from '../components/Faixa.astro';
import { imagem } from '../lib/assets';
import {
  site,
  contato,
  capa,
  ondeAtuei,
  sobre,
  metodo,
  comoTrabalho,
  destaques,
  revisao,
  rita,
  horn,
  outrosProjetos,
  rodape,
} from '../data/conteudo';

// Endereço oficial: definido em astro.config.mjs.
const base = (Astro.site?.toString() ?? '').replace(/\/$/, '');

const whatsapp = `https://wa.me/${contato.whatsappNumero}?text=${encodeURIComponent(contato.whatsappMensagem)}`;
const maiorReel = Math.max(...rita.reels.map((r) => r.visualizacoes));
const numero = (n: number) => n.toLocaleString('pt-BR');
const gruposReels = [...new Set(rita.reels.map((r) => r.grupo))];

// Versão ampliada das imagens, para abrir na janela de ampliar.
const ampliar = async (nome: string) => {
  const src = imagem(nome);
  return src ? (await getImage({ src, width: Math.min(src.width, 900), format: 'webp' })).src : undefined;
};
const printsRita = await Promise.all(rita.prints.map(async (p) => ({ ...p, grande: await ampliar(p.imagem) })));
const revisaoGrande = await ampliar(revisao.print.imagem);
const projetos = await Promise.all(
  outrosProjetos.projetos.map(async (p) => ({
    ...p,
    feedGrande: await ampliar(p.feed.imagem),
    detalheGrande: await ampliar(p.detalhe.imagem),
  })),
);

const iconeWhats =
  'M12 2.2a9.7 9.7 0 0 0-8.3 14.8L2.4 21.8l4.9-1.3A9.7 9.7 0 1 0 12 2.2Zm0 17.7a8 8 0 0 1-4.1-1.1l-.3-.2-2.9.8.8-2.8-.2-.3A8 8 0 1 1 12 19.9Zm4.4-6c-.2-.1-1.4-.7-1.7-.8-.2-.1-.4-.1-.5.1l-.8.9c-.1.2-.3.2-.5.1a6.6 6.6 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.5-.4h-.5a.9.9 0 0 0-.7.3 2.8 2.8 0 0 0-.9 2.1 4.9 4.9 0 0 0 1 2.6 11.2 11.2 0 0 0 4.3 3.8c1.6.7 2.2.7 3 .6a2.6 2.6 0 0 0 1.7-1.2 2.1 2.1 0 0 0 .2-1.2c-.1-.1-.2-.2-.5-.3Z';
const estrela = 'M10 0Q10 10 20 10Q10 10 10 20Q10 10 0 10Q10 10 10 0Z';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.titulo}</title>
    <meta name="description" content={site.descricao} />
    <meta name="theme-color" content="#2A5F4C" />
    <link rel="canonical" href={base + '/'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={site.titulo} />
    <meta property="og:description" content={site.descricao} />
    <meta property="og:url" content={base + '/'} />
    <meta property="og:image" content={base + '/og.png'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Esther Torres, social media e copywriting." />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>

    <!-- Menu flutuante -->
    <header class="menu" data-menu-barra>
      <a class="menu-nome" href="#topo">{capa.nome}</a>
      <nav aria-label="Seções">
        <ul>
          <li><a href="#onde" data-menu>Atuação</a></li>
          <li><a href="#destaques" data-menu>Trabalhos</a></li>
          <li><a href="#contato" data-menu>Contato</a></li>
        </ul>
        <span class="menu-marcador" aria-hidden="true"></span>
      </nav>
      <a class="menu-whats" href={whatsapp} target="_blank" rel="noopener" aria-label={capa.botao}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={iconeWhats}></path></svg>
      </a>
      <span class="menu-progresso" aria-hidden="true"></span>
    </header>

    <main id="conteudo">
      <!-- Capa -->
      <section class="capa escuro" id="topo" aria-labelledby="nome">
        <Ilustracao tipo="bananeira" class="il-capa" balanca paralaxe={0.12} />
        <div class="capa-texto">
          <h1 id="nome" class="capa-nome">
            <span>Esther</span>
            <span>Torres</span>
          </h1>
          <p class="capa-funcao">{capa.funcao}</p>
          <p class="capa-linha">{capa.linhaFina}</p>
          <blockquote class="capa-frase">
            <p>{capa.frase}</p>
          </blockquote>
          <a class="botao botao-caja" href={whatsapp} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d={iconeWhats}></path></svg>
            {capa.botao}
          </a>
          <ul class="capa-numeros">
            {
              capa.numeros.map((n) => (
                <li>
                  <a href={n.link}>
                    <strong>{n.valor}</strong>
                    <span>{n.rotulo}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="capa-retrato" data-mouse>
          <svg class="capa-astros" viewBox="0 0 400 480" aria-hidden="true" focusable="false">
            <circle class="sol-disco" cx="300" cy="110" r="86"></circle>
            <g class="sol-raios">
              {
                Array.from({ length: 24 }, (_, i) => {
                  const a = (i / 24) * Math.PI * 2;
                  return (
                    <line
                      x1={300 + Math.cos(a) * 100}
                      y1={110 + Math.sin(a) * 100}
                      x2={300 + Math.cos(a) * (i % 2 ? 114 : 128)}
                      y2={110 + Math.sin(a) * (i % 2 ? 114 : 128)}
                    />
                  );
                })
              }
            </g>
            <path class="lua" d="M46 30a26 26 0 1 0 24 36 21 21 0 1 1-24-36Z"></path>
            <circle class="ponto pisca" cx="84" cy="22" r="2.2"></circle>
            <circle class="ponto pisca" cx="24" cy="96" r="1.6" style="animation-delay:1.3s"></circle>
            <circle class="ponto pisca" cx="372" cy="300" r="1.8" style="animation-delay:2.1s"></circle>
          </svg>
          <div class="arco">
            <Foto
              nome={capa.retrato}
              alt={capa.retratoAlt}
              widths={[320, 480, 640, 860]}
              sizes="(min-width: 960px) 400px, 72vw"
              eager
            />
          </div>
        </div>
      </section>

      <Faixa frases={metodo} />

      <!-- Onde atuei -->
      <section class="claro secao com-ilustra" id="onde" aria-labelledby="onde-titulo">
        <Ilustracao tipo="ramo" class="il-onde" balanca paralaxe={-0.1} />
        <div class="largura">
          <h2 id="onde-titulo" class="titulo" data-revela="palavras">{ondeAtuei.titulo}</h2>
          <ol class="experiencias">
            {
              ondeAtuei.experiencias.map((e, i) => (
                <li class="experiencia" data-revela style={`--i:${i % 2}`}>
                  <h3 class="experiencia-empresa">{e.empresa}</h3>
                  <p class="experiencia-cargo">{e.cargo}</p>
                  {e.sobre && <p class="experiencia-sobre">{e.sobre}</p>}
                  <Etiquetas itens={e.tarefas} rotulo="" />
                  {e.resultado && (
                    <p class="experiencia-resultado">
                      <svg viewBox="0 0 20 20" aria-hidden="true">
                        <path d={estrela} />
                      </svg>
                      {e.resultado}
                    </p>
                  )}
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <!-- Sobre -->
      <section class="claro secao secao-sobre com-ilustra" id="sobre" aria-labelledby="sobre-titulo">
        <Ilustracao tipo="lua" class="il-sobre" paralaxe={0.08} />
        <div class="largura sobre">
          <div class="sobre-texto">
            <h2 id="sobre-titulo" class="titulo" data-revela="palavras">{sobre.titulo}</h2>
            <p class="sobre-destaque" data-revela="palavras">{sobre.destaque}</p>
            {sobre.paragrafos.map((p) => <p data-revela>{p}</p>)}
            <Etiquetas itens={sobre.habilidades} rotulo="No que eu trabalho" />
          </div>
          <div class="sobre-lado" data-revela="escala">
            <h3>Formação</h3>
            <ul class="formacao">
              {
                sobre.formacao.map((f) => (
                  <li>
                    <strong>{f.curso}</strong>
                    <span>
                      {f.onde}, {f.quando}
                    </span>
                  </li>
                ))
              }
            </ul>
            <h3>Ferramentas</h3>
            <ul class="ferramentas">
              {sobre.ferramentas.map((f) => <li>{f}</li>)}
            </ul>
          </div>
        </div>
      </section>

      <!-- Como eu trabalho -->
      <section class="escuro secao como ondula" aria-labelledby="como-titulo">
        <div class="largura como-grade">
          <div>
            <h2 id="como-titulo" class="como-rotulo" data-revela>{comoTrabalho.titulo}</h2>
            <p class="como-frase" data-revela="palavras">{comoTrabalho.frase}</p>
            <p class="como-complemento" data-revela>{comoTrabalho.complemento}</p>
            <p class="como-prova" data-revela>{comoTrabalho.prova}</p>
          </div>
          <CeuDoMes />
        </div>
      </section>

      <!-- Destaques -->
      <section class="claro secao com-ilustra ondula" id="destaques" aria-labelledby="destaques-titulo">
        <Ilustracao tipo="bananeira" class="il-destaques" balanca paralaxe={-0.15} />
        <div class="largura">
          <h2 id="destaques-titulo" class="titulo" data-revela="palavras">{destaques.titulo}</h2>

          <!-- Revisão -->
          <article class="caso" id={revisao.id} aria-labelledby="revisao-nome">
            <CasoTopo
              id="revisao"
              nome={revisao.nome}
              onde={revisao.onde}
              gancho={revisao.gancho}
              contexto={revisao.contexto}
              fiz={revisao.fiz}
            />
            <div class="revisao-grade">
              <div class="revisao-numeros">
                <div class="seguidores" data-revela>
                  <p class="numero">
                    <strong data-conta={revisao.seguidores.antes}>{revisao.seguidores.antes}</strong>
                    <span>{revisao.seguidores.antesRotulo}</span>
                  </p>
                  <svg class="seguidores-linha" viewBox="0 0 100 20" preserveAspectRatio="none" aria-hidden="true">
                    <line x1="4" y1="10" x2="96" y2="10" vector-effect="non-scaling-stroke"></line>
                  </svg>
                  <p class="numero">
                    <strong data-conta={revisao.seguidores.depois}>{revisao.seguidores.depois}</strong>
                    <span>{revisao.seguidores.depoisRotulo}</span>
                  </p>
                </div>
                <div class="campanha" data-revela>
                  <p class="numero numero-grande">
                    <strong data-conta={revisao.campanha.numero}>{revisao.campanha.numero}</strong>
                    <span>{revisao.campanha.rotulo}</span>
                  </p>
                  <p class="campanha-explica">{revisao.campanha.explicacao}</p>
                </div>
                <p class="nota" data-revela>{revisao.nota}</p>
              </div>
              <figure class="print print-revisao" data-revela="escala">
                <a href={revisaoGrande ?? '#'} data-ampliar aria-label={`Ampliar: ${revisao.print.alt}`}>
                  <Foto
                    nome={revisao.print.imagem}
                    alt={revisao.print.alt}
                    widths={[380, 560, 738]}
                    sizes="(min-width: 960px) 420px, 92vw"
                  />
                </a>
                <figcaption>{revisao.print.legenda}</figcaption>
              </figure>
            </div>
            {
              revisao.copyLandingPage && (
                <Raciocinio paragrafos={[]} rotulo="Ver a copy da landing page">
                  <div class="landing">
                    <h4>{revisao.copyLandingPage.titulo}</h4>
                    <p>{revisao.copyLandingPage.texto}</p>
                    {revisao.copyLandingPage.link && (
                      <a href={revisao.copyLandingPage.link} target="_blank" rel="noopener">
                        Ver a página no ar
                      </a>
                    )}
                  </div>
                </Raciocinio>
              )
            }
          </article>

          <!-- Dra. Rita Leão -->
          <article class="caso" id={rita.id} aria-labelledby="rita-nome">
            <CasoTopo
              id="rita"
              nome={rita.nome}
              onde={rita.onde}
              gancho={rita.gancho}
              contexto={rita.contexto}
              fiz={rita.fiz}
            />

            <div class="rita-prova">
              <figure class="reels" data-anima data-revela>
                <figcaption class="reels-titulo">Visualizações por Reel</figcaption>
                {
                  gruposReels.map((grupo) => (
                    <div class:list={['reels-grupo', { 'reels-meus': grupo !== gruposReels[0] }]}>
                      <p class="reels-grupo-nome">{grupo}</p>
                      <ul>
                        {rita.reels
                          .filter((r) => r.grupo === grupo)
                          .map((r) => (
                            <li style={`--valor:${(r.visualizacoes / maiorReel).toFixed(4)}`}>
                              <span class="reels-tema">{r.tema}</span>
                              <span class="reels-barra" aria-hidden="true" />
                              <span class="reels-valor">{numero(r.visualizacoes)}</span>
                            </li>
                          ))}
                      </ul>
                    </div>
                  ))
                }
                <p class="reels-escala" aria-hidden="true">
                  <span>0</span>
                  <span>{numero(maiorReel)}</span>
                </p>
              </figure>

              <div class="prints-bloco">
                <ul class="prints-rita" aria-label="Prints dos insights dos quatro Reels" data-revela="cascata">
                  {
                    printsRita.map((p, i) => (
                      <li style={`--i:${i}`}>
                        <a href={p.grande ?? '#'} data-ampliar aria-label={`Ampliar: ${p.alt}`}>
                          <Foto nome={p.imagem} alt={p.alt} widths={[200, 320]} sizes="(min-width: 960px) 140px, 44vw" />
                        </a>
                        <span class:list={['print-tag', `print-tag-${p.tipo}`]}>
                          {p.tipo === 'antes' ? 'Reel anterior' : 'Com roteiro meu'}
                        </span>
                      </li>
                    ))
                  }
                </ul>
                <p class="prints-dica">Toque em um print para ampliar.</p>
              </div>
            </div>

            <Carrossel carrossel={rita.carrossel} dono={rita.nome} />
            <Raciocinio paragrafos={rita.raciocinio} />
          </article>
        </div>
      </section>

      <!-- Dra. Gabriela Horn -->
      <section class="escuro secao caso-escuro com-ilustra ondula" aria-labelledby="horn-nome">
        <Ilustracao tipo="ramo" class="il-horn" balanca paralaxe={-0.1} />
        <div class="largura">
          <article class="caso" id={horn.id}>
            <CasoTopo
              id="horn"
              nome={horn.nome}
              onde={horn.onde}
              gancho={horn.gancho}
              contexto={horn.contexto}
              fiz={horn.fiz}
            />
            <Carrossel carrossel={horn.carrossel} dono={horn.nome} />
            <Raciocinio paragrafos={horn.raciocinio} />
          </article>
        </div>
      </section>

      <Faixa frases={metodo} reverso />

      <!-- Outros projetos -->
      <section class="claro secao com-ilustra" id="outros" aria-labelledby="outros-titulo">
        <Ilustracao tipo="flor" class="il-outros" paralaxe={0.1} />
        <div class="largura">
          <h2 id="outros-titulo" class="titulo" data-revela="palavras">{outrosProjetos.titulo}</h2>
          <p class="titulo-apoio" data-revela>{outrosProjetos.intro}</p>
          <div class="outros">
            {
              projetos.map((p, i) => (
                <article class="cartao" data-revela style={`--i:${i}`}>
                  <div class="cartao-imagens">
                    <a class="print" href={p.feedGrande ?? '#'} data-ampliar aria-label={`Ampliar: ${p.feed.alt}`}>
                      <Foto nome={p.feed.imagem} alt={p.feed.alt} widths={[240, 360, 480]} sizes="(min-width: 960px) 180px, 32vw" />
                    </a>
                    <a class="print" href={p.detalheGrande ?? '#'} data-ampliar aria-label={`Ampliar: ${p.detalhe.alt}`}>
                      <Foto nome={p.detalhe.imagem} alt={p.detalhe.alt} widths={[320, 480, 640]} sizes="(min-width: 960px) 320px, 56vw" />
                    </a>
                  </div>
                  <p class="cartao-tipo">{p.tipo}</p>
                  <h3 class="cartao-nome">{p.nome}</h3>
                  <p class="cartao-desafio">{p.desafio}</p>
                  <p>{p.texto}</p>
                  <Etiquetas itens={p.fiz} />
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Contato -->
      <section class="escuro secao contato com-ilustra ondula" id="contato" aria-labelledby="contato-titulo">
        <Ilustracao tipo="sol" class="il-contato" paralaxe={0.1} />
        <div class="largura contato-grade">
          <div>
            <div class="contato-retrato" data-revela="escala">
              <Foto nome={capa.retrato} alt="" widths={[160, 240]} sizes="120px" />
            </div>
            <p class="contato-chamada" data-revela>{rodape.chamada}</p>
            <h2 id="contato-titulo" class="contato-titulo" data-revela="palavras">{rodape.titulo}</h2>
            <p class="contato-texto" data-revela>{rodape.texto}</p>
          </div>
          <div class="contato-acoes" data-revela="cascata">
            <a class="botao botao-caja" href={whatsapp} target="_blank" rel="noopener" style="--i:0">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d={iconeWhats}></path></svg>
              {contato.botaoWhatsapp}
            </a>
            <div class="contato-email" style="--i:1">
              <a class="botao botao-contorno" href={`mailto:${contato.email}`}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18v12H3z M3 7l9 6 9-6"></path></svg>
                {contato.botaoEmail}
              </a>
              <button type="button" class="copiar" data-copiar={contato.email}>
                <span data-copiar-texto>{contato.botaoCopiar}</span>
              </button>
            </div>
            <a class="botao botao-contorno botao-linkedin" href={contato.linkedin} target="_blank" rel="noopener" style="--i:2">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 9h3.5v11H4z M5.75 3.5a2 2 0 1 1 0 4 2 2 0 0 1 0-4z M10 9h3.4v1.6c.5-.9 1.7-1.9 3.6-1.9 3.6 0 4 2.3 4 5.3V20h-3.5v-5.3c0-1.3 0-2.9-1.8-2.9s-2.1 1.4-2.1 2.8V20H10z"></path>
              </svg>
              {contato.botaoLinkedin}
            </a>
          </div>
        </div>
      </section>
    </main>

    <div class="chita" aria-hidden="true"></div>
    <footer class="rodape escuro">
      <p>{capa.nome}, {capa.funcao.toLowerCase()}.</p>
    </footer>

    <dialog class="lupa" data-lupa aria-label="Imagem ampliada">
      <button type="button" class="lupa-fechar" data-lupa-fechar aria-label="Fechar imagem ampliada">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      </button>
      <img data-lupa-img alt="" />
    </dialog>

    <script>
      import { iniciar } from '../lib/movimento';
      iniciar();
    </script>
  </body>
</html>
